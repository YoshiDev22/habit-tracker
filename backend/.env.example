DATABASE_URL=sqlite:///./habits.db
SECRET_KEY=

# Opcional. "false" cierra el registro de cuentas nuevas; las existentes siguen
# entrando. Sin la variable, el registro queda abierto.
# ALLOW_REGISTRATION=false

# Opcional. IA para el texto de los reportes (épica 30, Fase 5). Un solo
# proveedor para toda la instancia, con el formato "chat completions" de OpenAI.
# Sin AI_BASE_URL o AI_MODEL, el texto sale de reglas fijas. Además, cada cuenta
# necesita acceso: python3 scripts/grant_module.py --email ... --module ai
#
# Cloudflare Workers AI (10,000 neurons al día gratis: unos 20 reportes):
#   AI_PROVIDER=cloudflare
#   AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   AI_API_KEY=<token de API con permiso de Workers AI>
#   AI_MODEL=@cf/openai/gpt-oss-120b
# Google Gemini (en la capa gratuita, Google usa el contenido para mejorar sus productos):
#   AI_PROVIDER=gemini
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=<un modelo Flash vigente: ver ai.google.dev/gemini-api/docs/models>
# OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.openai.com/v1
# Un servidor local (llama.cpp, LM Studio, Ollama), sin clave:
#   AI_PROVIDER=local
#   AI_BASE_URL=http://localhost:8080/v1
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Llamadas por cuenta y día (UTC), y segundos de espera por llamada. Los reportes
# de tiempo y de hábitos comparten AI_DAILY_LIMIT; los de costos tienen el suyo.
# AI_DAILY_LIMIT=10
# AI_COSTS_DAILY_LIMIT=10
# AI_TIMEOUT=60

# Opcional. Segundos de espera entre dos generaciones a mano del mismo reporte
# (Regenerar o Reescribir con IA), para que los clics repetidos no gasten la IA.
# REPORT_COOLDOWN_SECONDS=30

# Aviso de privacidad (/privacidad, backend/privacy.py). Lo que hace el código está en el
# texto; quién responde y con qué proveedores corre esta instancia, aquí. Sin PRIVACY_EMAIL
# la página avisa que falta el contacto. PRIVACY_PROXY y PRIVACY_AI son opcionales: sin
# ellos, sus frases no salen (con IA configurada y sin PRIVACY_AI, se nombra de forma genérica).
# PRIVACY_EMAIL=privacidad@tu-dominio.com
# PRIVACY_HOSTING=Proveedor (servidor en País)
# PRIVACY_PROXY=Cloudflare
# PRIVACY_AI=Cloudflare Workers AI, que dice no usarlo para entrenar modelos

# Solo para el panel de administración (backend/admin_main.py, un proceso aparte de
# la app). La app pública no las lee. Sin las tres, el panel no arranca. Los valores
# salen de Cloudflare Zero Trust (Access › Applications): el nombre del equipo
# (<equipo>.cloudflareaccess.com) y el "Application Audience (AUD) Tag" de la app.
# ADMIN_EMAILS=tu-correo@ejemplo.com
# ADMIN_ACCESS_TEAM=<equipo>
# ADMIN_ACCESS_AUD=<AUD tag de la aplicación de Access>
